---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  lang?: string;
}

const { title, description, image, canonicalURL, lang = "en" } = Astro.props;
---

<Layout
  title={title}
  description={description}
  image={image}
  canonicalURL={canonicalURL}
  lang={lang}
>
  <Header lang={lang} />

  <main class="pt-16">
    <slot />
  </main>

  <Footer lang={lang} />
</Layout>
